# Copy this file to .env (same folder) and fill in your keys.
# .env is gitignored; never commit real keys. Restart npm run demo after editing.

# Gemini: writes the narration script and, later, the video shot list.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ElevenLabs: the narrator's voice. Both lines are needed for audio.
# Key: https://elevenlabs.io/app/settings/api-keys
# Voice ID: open a voice in https://elevenlabs.io/app/voice-library and copy its ID.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Higgsfield: turns tour frames into video clips. Create a key in Higgsfield
# Cloud; it has two parts, an ID and a secret, shown only once.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
